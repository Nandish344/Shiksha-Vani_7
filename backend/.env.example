# ---------- Core ----------
# SQLite by default (zero setup). For PostgreSQL use:
#   DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/shikshavani
DATABASE_URL=sqlite:///./shikshavani.db
JWT_SECRET=change-me-in-production
DEMO_MODE=true                 # enables one-click demo logins + seeded data
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- Translation / Speech (all optional) ----------
# Bhashini (https://bhashini.gov.in -> register -> ULCA -> "My Profile" -> API keys)
BHASHINI_USER_ID=
BHASHINI_API_KEY=
# Free public fallback for hi/en/bn/or... (NOT for tribal languages). Good for demos.
ENABLE_PUBLIC_FALLBACK=false
# Optional OpenAI-compatible Whisper endpoint for teacher speech -> text
WHISPER_API_URL=
WHISPER_API_KEY=

# ---------- AI tutor (optional; works without via lesson retrieval) ----------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
